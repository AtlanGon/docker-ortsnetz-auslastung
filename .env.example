# Ziel-API fuer Messungen (Ortsnetz-Auslastung).
API_URL=https://www.ortsnetz-auslastung.de/v1/measurements
# Standortkoordinaten als Dezimalgrad.
LATITUDE=52.520008
LONGITUDE=13.404954
# Optionale installierte PV-Leistung in kWp; fuer PV-Prognosen erforderlich.
PLANT_CAPACITY_KWP=
# Optionale Bezeichnung des Smart Meters.
SMARTMETER_MODEL=
# Datenquelle: mqtt oder solarassistant.
DATA_SOURCE=mqtt
# Abstand zwischen Messungen in Millisekunden (300000 = 5 Minuten).
UPLOAD_INTERVAL_MS=300000

# MQTT-Quelle: Broker-URL; bei lokalem Broker Hostname/IP und Port anpassen.
MQTT_URL=mqtt://host.docker.internal:1883
# MQTT-Zugangsdaten; leer lassen, wenn der Broker keine Authentifizierung verlangt.
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT-Topics mit Phasenspannungen in Volt; alle drei sind erforderlich.
MQTT_TOPIC_L1=mbmd/sdm1-1/Voltage/L1
MQTT_TOPIC_L2=mbmd/sdm1-1/Voltage/L2
MQTT_TOPIC_L3=mbmd/sdm1-1/Voltage/L3
# Optionales Topic mit Netzfrequenz in Hz; leer lassen, wenn nicht verfuegbar.
MQTT_TOPIC_FREQUENCY=mbmd/sdm1-1/Frequency
# Optionales Topic mit heutiger PV-Prognose in Wh.
MQTT_TOPIC_PV_FORECAST=
# JSON-Pfad fuer Spannungs-/Frequenz-Payloads; leer bei rein numerischen Payloads.
MQTT_JSON_KEY=
# JSON-Pfad fuer die PV-Prognose; nur relevant, wenn MQTT_TOPIC_PV_FORECAST gesetzt ist.
MQTT_PV_FORECAST_JSON_KEY=today.energy
# Maximales Alter eines MQTT-Werts in Millisekunden (360000 = 6 Minuten).
MQTT_MAX_VALUE_AGE_MS=360000

# SolarAssistant-REST-Quelle: Basis-URL oder vollstaendige /api/v1/metrics-URL.
# Der Adapter ergaenzt /api/v1/metrics automatisch, wenn nur die Basis-URL angegeben ist.
SA_API_URL=http://192.168.0.100
# Lokaler Geraetebenutzer fuer Basic Auth (SolarAssistant verwendet standardmaessig admin).
SA_API_USERNAME=admin
# Geraetepasswort fuer Basic Auth; alternativ SA_API_TOKEN verwenden.
SA_API_PASSWORD=
# Optionaler Bearer-Token; hat Vorrang vor Benutzername und Passwort, wenn gesetzt.
SA_API_TOKEN=
# Exakte Metric-Topics aus GET /api/v1/metrics fuer Phasenspannungen in Volt.
# Die verfuegbaren Topic-Namen haengen von der SolarAssistant-Installation ab.
SA_METRIC_TOPIC_L1=
SA_METRIC_TOPIC_L2=
SA_METRIC_TOPIC_L3=
# Optionales Metric-Topic fuer Netzfrequenz in Hz.
SA_METRIC_TOPIC_FREQUENCY=